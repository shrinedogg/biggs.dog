{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:enableMajor",
    ":disableRateLimiting",
    ":dependencyDashboard",
    ":semanticCommits",
    ":automergeBranch"
  ],
  "dependencyDashboardTitle": "Renovate Dashboard \ud83e\udd16",
  "suppressNotifications": ["prEditedNotification", "prIgnoreNotification"],
  "rebaseWhen": "conflicted",
  "schedule": ["0 10 * * *"],
  "ignorePaths": ["**/apps.yaml"],
  "flux": {
    "managerFilePatterns": ["(^|/)clusters/.+\\.ya?ml$"]
  },
  "helm-values": {
    "managerFilePatterns": ["(^|/)clusters/.+\\.ya?ml$"]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "(^|/)clusters/.+\\.ya?ml$",
      "(^|/)clusters/.+/(deployment|job|cronjob|daemonset|statefulset)\\.ya?ml$",
      "(^|/)clusters/.+-deployment\\.ya?$"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Flux OCIRepository sources (chartRef chart version) \u2014 tracks the tag in the source file, which is where Flux Operator HelmReleases get their version from",
      "managerFilePatterns": ["(^|/)clusters/.+-oci\\.ya?ml$"],
      "matchStrings": [
        "url:\\s*oci://(?<depName>[^\\s]+)\\n\\s*ref:\\n\\s*tag:\\s*[\"']?(?<currentValue>[^\"'\\s]+)[\"']?",
        "ref:\\s*\\n\\s*tag:\\s*[\"']?(?<currentValue>[^\"'\\s]+)[\"']?\\s*\\n\\s*url:\\s*oci://(?<depName>[^\\s]+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Flux GitRepository sources with ref.tag (chartRef chart version) \u2014 tracks GitHub release tags for Git-sourced Helm charts",
      "managerFilePatterns": ["(^|/)clusters/.+-git\\.ya?ml$"],
      "matchStrings": [
        "url:\\s*https://github.com/(?<depName>[^/]+/[^/]+?)(?:\\.git)?\\s*\\n\\s*ref:\\s*\\n\\s*tag:\\s*[\"\\']?(?<currentValue>[^\"\\'\\s]+)[\"\\']?"
      ],
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "CNPG ClusterImageCatalog extension images (reference: field, which the kubernetes manager ignores)",
      "managerFilePatterns": ["(^|/)clusters/.+catalog\\.ya?ml$"],
      "matchStrings": [
        "reference:\\s*(?<depName>[^\\s:@]+):(?<currentValue>[^\\s@]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Flux HelmRelease dependencies",
      "matchManagers": ["flux"],
      "matchDatasources": ["helm"],
      "commitMessageTopic": "chart {{depName}}"
    },
    {
      "description": "Auto-merge non-major Helm chart updates",
      "matchManagers": ["flux"],
      "matchDatasources": ["helm"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Group Rook Ceph charts",
      "matchManagers": ["flux"],
      "matchDatasources": ["helm"],
      "groupName": "rook-ceph",
      "matchPackageNames": ["/^rook-ceph/"]
    },
    {
      "description": "Group VictoriaMetrics charts",
      "matchManagers": ["flux"],
      "matchDatasources": ["helm"],
      "groupName": "victoria-metrics",
      "matchPackageNames": ["/^victoria/"]
    },
    {
      "description": "Group external-secrets charts",
      "matchManagers": ["flux"],
      "matchDatasources": ["helm"],
      "groupName": "external-secrets",
      "matchPackageNames": ["/external-secrets/", "/connect/"]
    },
    {
      "description": "Group observability charts",
      "matchManagers": ["flux"],
      "matchDatasources": ["helm"],
      "groupName": "observability",
      "matchPackageNames": ["/grafana/", "/prometheus/"]
    },
    {
      "description": "Semantic versioning for Cilium",
      "matchManagers": ["flux"],
      "matchDatasources": ["helm"],
      "matchPackageNames": ["cilium"],
      "separateMajorMinor": true
    },
    {
      "description": "Semantic versioning for cert-manager",
      "matchManagers": ["flux"],
      "matchDatasources": ["helm"],
      "matchPackageNames": ["cert-manager"],
      "separateMajorMinor": true
    },
    {
      "description": "Track plugin-barman-cloud chart and flag the TLS cert workaround",
      "matchManagers": ["custom.regex"],
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "ghcr.io/cloudnative-pg/charts/plugin-barman-cloud"
      ],
      "commitMessageTopic": "chart plugin-barman-cloud",
      "automerge": false,
      "prBodyNotes": [
        ":warning: This repo carries a workaround for cloudnative-pg/charts#781 (broken chart TLS certs on cert-manager >= 1.18): `certificate.createServerCertificate`/`createClientCertificate` are set to `false` in the HelmRelease and the server/client certs are self-managed in `apps/cnpg/barman/certificates/` (reconciled by the `cnpg-barman-certs` Kustomization).",
        "Before merging, check whether this release fixes #781 or wires `certificate.issuerName` (PR #811). If so, you can point `issuerName` at `barman-cloud-ca-issuer` (or re-enable the chart certs) and remove the `certificates/` directory and the `cnpg-barman-certs` Kustomization."
      ]
    },
    {
      "description": "Track floating tags by digest. Tags like latest/edge/main are not versions, so Renovate skips them as invalid-value; pinning the digest lets it raise update PRs when the tag is rebuilt. (nsyncd is also semver-tracked; the digest pin just adds rebuild-level updates.)",
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "ghcr.io/continuwuity/continuwuity",
        "ghcr.io/games-on-whales/firefox",
        "ghcr.io/games-on-whales/steam",
        "ghcr.io/squat/generic-device-plugin",
        "quay.io/aminvakil/alpine-nfs-server",
        "szkud/biggslanding",
        "michaelf34/infinity",
        "shrinedogg/nsyncd",
        "ersatztv/legacy"
      ],
      "pinDigests": true
    },
    {
      "description": "Group CNPG operand + extension catalog images so the catalog updates as one set",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["/^ghcr\\.io/cloudnative-pg//"],
      "groupName": "cnpg-images"
    },
    {
      "description": "Group media app container images",
      "matchManagers": ["kubernetes"],
      "matchDatasources": ["docker"],
      "matchFileNames": ["clusters/**/media/**"],
      "groupName": "media-apps"
    },
    {
      "description": "Auto-merge patch updates for media apps",
      "matchManagers": ["kubernetes"],
      "matchDatasources": ["docker"],
      "matchFileNames": ["clusters/**/media/**"],
      "matchUpdateTypes": ["patch"],
      "automerge": true
    }
  ]
}
